<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necessária para listar os aplicativos instalados pelo usuário -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Detecção de app em primeiro plano (concedida manualmente pelo usuário) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Encerramento de processos em segundo plano sem Shizuku (fallback limitado) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Bolha flutuante: o usuário concede na tela oficial do Android -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Shizuku -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.hamondev.shevery" />
        <!-- Necessário para abrir o canal no navegador ou no app do YouTube -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".BgControlApp"
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BgControlPlus">

        <!-- singleTop: o toque longo na bolha traz esta mesma tela de volta em
             vez de empilhar outra cópia, e o pedido chega em onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BgControlPlus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".monitor.BlockedAppWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitora quando aplicativos bloqueados saem do primeiro plano para encerrá-los" />
        </service>

        <!-- Serviço de persistência: mantém o processo vivo mesmo fechado -->
        <service
            android:name=".monitor.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantém o processo do aplicativo ativo em segundo plano para que bloqueios e agendamentos funcionem sem abrir o app" />
        </service>

        <!-- Notificação fixa e bolha flutuante -->
        <service
            android:name=".quick.QuickAccessService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantém a notificação de ação rápida e a bolha flutuante do usuário" />
        </service>

        <!-- Bloco das Configurações Rápidas (Android 7+) -->
        <service
            android:name=".qs.CloseAllTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_close_all"
            android:label="@string/close_all"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- Dispara os grupos de limpeza agendada -->
        <!-- Receptor que relança os serviços quando o alarme periódico dispara -->
        <receiver
            android:name=".monitor.KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bgcontrol.plus.KEEP_ALIVE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bgcontrol.plus.RUN_SCHEDULE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".monitor.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Huawei/Xiaomi/OnePlus usam este evento no lugar do padrão -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- Relança os serviços após atualizar o próprio aplicativo -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
